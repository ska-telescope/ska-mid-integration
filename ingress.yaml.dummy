## Ingress resource for the ska-k8s-config-exporter service

apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: ska-k8s-config-exporter-ingress
  namespace: ska-tmc-integration
  annotations:
    nginx.ingress.kubernetes.io/rewrite-target: /
spec:
  rules:
  - host: {{ .Values.ingress.host | quote }}  # Uses the host from values.yaml
    http:
      paths:
      - path: {{ .Values.ingress.path }}
        pathType: Prefix
        backend:
          service:
            name: {{ .Values.ingress.serviceName }}
            port:
              number: {{ .Values.ingress.servicePort }}
